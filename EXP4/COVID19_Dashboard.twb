    <worksheet name='Sheet 6'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Case Fatality Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='owid-covid-data' name='federated.1dh73o70bf5cvf1cg0bvc18oe0rh' />
          </datasources>
          <datasource-dependencies datasource='federated.1dh73o70bf5cvf1cg0bvc18oe0rh'>
            <column caption='Case_Fatality_Rate' datatype='real' name='[Calculation_1990419604959237]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_deaths])&#13;&#10;/&#13;&#10;SUM([total_cases])&#13;&#10;*100' />
            </column>
